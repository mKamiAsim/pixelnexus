{
  "name": "@pixelnexus/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PixelNexus studio: the browser app and the browser engine.",
  "license": "MIT",
  "scripts": {
    "gen": "node scripts/gen-catalog-types.mjs",
    "dev": "pnpm gen && vite",
