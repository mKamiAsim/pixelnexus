    "test:watch": "pnpm gen && vitest",
    "test:coverage": "pnpm gen && vitest run --coverage",
    "lint": "pnpm gen && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "bench:viewport": "node scripts/bench-viewport.mjs",
    "bench:filters": "node scripts/bench-filters.mjs",
    "gen:filter-docs": "pnpm gen && node scripts/gen-filter-docs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "dockview-react": "^8.4.0",
    "katex": "^0.18.10",
    "lucide-react": "^1.49.0",
    "onnxruntime-web": "1.30.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "utif2": "^4.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
