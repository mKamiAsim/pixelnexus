# PixelNexus configuration example.
# Copy this file to .env and change the values you need.
# Never commit a real .env file.

# Science engine (Python)
PIXELNEXUS_ENGINE_HOST=127.0.0.1
PIXELNEXUS_ENGINE_PORT=8765
# Comma-separated list of web origins allowed to call the engine.
PIXELNEXUS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Largest accepted upload, in megabytes. Images travel as raw RGBA, 4 bytes per pixel.
PIXELNEXUS_MAX_UPLOAD_MB=256
# Largest accepted image, in pixels (width x height).
PIXELNEXUS_MAX_PIXELS=50000000
# Folder for AI models that you download. Used from Phase 7.
PIXELNEXUS_MODELS_DIR=./models
# Where models run: auto (CUDA if it really works, else the CPU), cpu or cuda.
PIXELNEXUS_DEVICE=auto
# How many filter jobs run at once, each in its own process. Default: half the CPU cores.
# PIXELNEXUS_MAX_WORKERS=4
# Memory for uploaded images, in megabytes. The least recently used are dropped first.
PIXELNEXUS_CACHE_MB=1024
# Disk space for image encoder results of click and box selection, in megabytes, kept in a
# .embeddings folder inside the models folder. The oldest are dropped first. 0 turns it off.
PIXELNEXUS_EMBEDDINGS_MB=512
# The catalog/filters folder. Default: found by searching up from the working folder.
# PIXELNEXUS_CATALOG_DIR=./catalog/filters

# Studio (web)
# Address of the science engine as seen from the browser.
VITE_ENGINE_URL=http://127.0.0.1:8765
